{
  "name": "ulebelt-regenton",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build && vite build -c vite.server.config.ts",
    "start": "node scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "npm run test:vite && npm run test:e2e",
    "test:vite": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "digest": "node dist/server/jobs.js digest",
    "beheerder": "vite build -c vite.server.config.ts --logLevel warn && node dist/server/jobs.js beheerder"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "solid-js": "^1.9.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/router": "^1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
