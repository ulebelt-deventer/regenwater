# Copy to devops/<env>.env (gitignored, env = staging or production), replace every value, then run devops/push-env.sh <env>. All values below are fake.
# APP_MODUS, PORT, DATA_DIR, TZ and PLAYWRIGHT_BROWSERS_PATH are set by the systemd units, not here.
BASIS_URL=https://regenwater-staging.example.org
# Any non-blank value shows a yellow TEST label in the navbar and an orange "no real data" banner above it, and prefixes every mail subject with [TEST]. Set it on test and demo installs, leave it out on the live site.
STAGING=1
# The address of the proefomgeving that new ones at /proberen copy (docs/proefomgevingen.md): one you receive mail on but use nowhere else, such as a plus-address, with a made-up, distinctive name on the account. Without it they start empty.
PROEF_SJABLOON=sjabloon.beheerder@example.org
MAILGUN_API_KEY=0000000000fake0000000000000000-00000000-00000000
# The Mailgun sending domain, and the region it was created in: eu (the default) or us.
MAILGUN_DOMEIN=mg.example.org
# MAILGUN_REGIO=eu
MAIL_AFZENDER=Ulebelt Regenwater (TEST) <regenwater-test@example.org>
# Who gets an email for each feedback item, comma-separated. Push it before deploying: the app won't start without it.
MELDINGEN_FEEDBACK=ontwikkelaar@example.org
# Healthchecks.io check 1 (period 1 day): the app pings it daily and /fail on warnings and errors (at most hourly).
HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000001
# Healthchecks.io check 2 (period 1 day): the daily backup check pings it, or /fail.
BACKUP_HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000002
# S3-compatible bucket in the EU (Scaleway shown), with versioning and a retention rule set on the bucket itself. Litestream writes regenton-<env>/db/, rclone writes regenton-<env>/fotos/. Required only with BACKUPS=s3 in deploy.<env>.env.
S3_ENDPOINT=https://s3.nl-ams.scw.cloud
S3_REGION=nl-ams
S3_BUCKET=example-regenton-backups
S3_ACCESS_KEY_ID=SCWFAKEFAKEFAKEFAKE0
S3_SECRET_ACCESS_KEY=00000000-fake-fake-fake-000000000000
