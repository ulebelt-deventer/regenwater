# Copy to devops/production.env (gitignored), fill in, then run devops/push-env.sh.
# APP_MODUS, PORT, DATA_DIR, TZ and PLAYWRIGHT_BROWSERS_PATH are set by the systemd units, not here.
BASIS_URL=https://
# Any non-blank value shows a yellow TEST label in the navbar. Set it on test and demo installs, leave it out on the live site.
# STAGING=1
MAILGUN_API_KEY=
# The Mailgun sending domain, and the region it was created in: eu (the default) or us.
MAILGUN_DOMEIN=
# MAILGUN_REGIO=us
MAIL_AFZENDER=Ulebelt Regenwater <regenwater@ulebelt.nl>
# Healthchecks.io check 1 (period 1 day): the app pings it daily and /fail on warnings and errors (at most hourly).
HEALTHCHECK_URL=
# Healthchecks.io check 2 (period 1 day): the daily backup check pings it, or /fail.
BACKUP_HEALTHCHECK_URL=
# S3-compatible bucket in the EU, with versioning and a retention rule set on the bucket itself. Litestream writes db/, rclone writes fotos/.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
